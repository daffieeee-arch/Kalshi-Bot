# Demo plumbing (discover / optional demo POST later). Never commit the real .env.
# Demo keys: https://demo.kalshi.co/ → Account → API Keys

KALSHI_ENV=demo
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=

# Live analysis reads production WebSocket only. Trade stays paper.
# Live keys: https://kalshi.com/ → Account → API Keys (prefer your own RSA public key).
# Docs: https://docs.kalshi.com/

KALSHI_DATA_ENV=production
KALSHI_TRADE_ENV=paper
KALSHI_PROD_API_KEY_ID=
KALSHI_PROD_PRIVATE_KEY_PATH=

# Hosts are not overridable:
#   demo REST  https://external-api.demo.kalshi.co/trade-api/v2
#   demo WS    wss://external-api-ws.demo.kalshi.co/trade-api/ws/v2
#   prod REST  https://external-api.kalshi.com/trade-api/v2
#   prod WS    wss://external-api-ws.kalshi.com/trade-api/ws/v2
